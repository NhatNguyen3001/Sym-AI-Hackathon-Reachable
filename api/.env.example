# Copy to api/.env and fill in. api/.env is gitignored: never commit real keys.

# Claude (needs parsing, route explanations, photo labels). Empty = rule-based fallbacks.
ANTHROPIC_API_KEY=

# Database. Local SQLite file by default.
DATABASE_URL=sqlite:///./reachable.db

# Turso (hosted libSQL). When TURSO_DATABASE_URL is set the API uses Turso and ignores DATABASE_URL.
# Leave both empty to use the local SQLite file above (the campus quick start does).
# `turso db show <db> --url` gives libsql://<db>-<org>.turso.io ; `turso db tokens create <db>` gives the token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Browsers allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:3000"]

# Routing: "valhalla" (Greater Sydney, needs `docker compose up -d valhalla`) or "campus" (no Docker).
ROUTER=valhalla
VALHALLA_URL=http://localhost:8002
MAX_LEG_KM=10
COVERAGE_BBOX=149.97,-34.33,151.63,-32.99

# Place search. Empty PHOTON_URL disables address search (campus places only).
PHOTON_URL=https://photon.komoot.io
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Walking/rolling speed used for minutes, metres per second.
SPEED_MPS=1.0

# Transport for NSW Open Data: public transport trips and live lift alerts.
# Get a free key at https://opendata.transport.nsw.gov.au. Empty = both off (walk/roll only, lifts "Not sure").
TFNSW_API_KEY=
TFNSW_URL=https://api.transport.nsw.gov.au
# Trips longer than this (straight line, km) also get public transport options.
TRANSIT_MIN_KM=1
# How often to check lift alerts, in seconds (0 = never in the background).
LIFT_POLL_SECONDS=300
